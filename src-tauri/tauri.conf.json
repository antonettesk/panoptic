{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panoptic",
  "version": "0.1.0",
  "identifier": "io.panoptic.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Panoptic — Cross-Layer Threat Hunting",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#090B10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "publisher": "Panoptic Core Team",
    "category": "Utility",
    "shortDescription": "Cross-platform threat hunting tool",
    "longDescription": "Panoptic detects rootkits, hidden processes, hidden network listeners and persistence mechanisms by comparing what high-level OS APIs report against low-level kernel reality. Works fully offline.",
    "copyright": "Copyright (c) 2026 Panoptic Contributors. Licensed under the GNU AGPL v3.0.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/panoptic-cli"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "perMachine" }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
